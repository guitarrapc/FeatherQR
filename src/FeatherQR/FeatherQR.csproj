<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>FeatherQR</RootNamespace>
    <!-- ARM64 bit expansion reads a destination address only to choose an alignment hint. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Runs the code-style rules of .editorconfig in the build and enforces IDE0251 for struct members -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FeatherQR</PackageId>
    <Description>QR Code, Micro QR and rMQR encoder and decoder for .NET. Zero dependencies, zero allocations on the hot paths, trim and NativeAOT safe. Rendering lives in FeatherQR.SkiaSharp.</Description>

    <!-- API compatibility. Ensures that the package is compatible with the last released version. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Trimming/NativeAOT. IsAotCompatible turns on the trim/AOT/single-file analyzers. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>

    <!-- SBOM -->
    <GenerateSBOM>true</GenerateSBOM>
    <SbomGenerationFetchLicenseInformation>true</SbomGenerationFetchLicenseInformation>
    <SbomGenerationEnablePackageMetadataParsing>true</SbomGenerationEnablePackageMetadataParsing>
    <SbomGenerationManifestInfo>SPDX:2.2</SbomGenerationManifestInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- The rendering package reaches the module-run enumerator and the luminance kernels
         through internals during the split; every use is enumerated in the architecture
         record and gets a public replacement or a recorded reason. -->
    <InternalsVisibleTo Include="FeatherQR.SkiaSharp, " />
    <!-- The NativeAOT gate and the WebAssembly report print Internals.SimdTiers.Report() from their
         builds: which SIMD tier each kernel runs there is the build's answer, and no public API carries it. -->
    <InternalsVisibleTo Include="FeatherQR.AotAnalysis, " />
    <InternalsVisibleTo Include="FeatherQR.WasmReport, " />
    <InternalsVisibleTo Include="FeatherQR.Tests, " />
  </ItemGroup>

  <!-- No SkiaSharp here, by design. tests/.../CoreAssemblyDependencyTest asserts it from metadata
       on every target framework. The netstandard targets need the BCL shims that used to arrive
       through SkiaSharp: Span/ArrayPool/Unsafe live in packages there and in the framework on net8.0+. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
