<Project Sdk="Microsoft.NET.Sdk">

  <!-- Metapackage. SkiaSharp.QrCode ships no assembly since 2.0.0: it exists so that <PackageReference Include="SkiaSharp.QrCode" /> keeps restoring after the split, and resolves to FeatherQR.SkiaSharp -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
    <PackageId>SkiaSharp.QrCode</PackageId>
    <!-- Its own README says what the package is; the root README describes the library. -->
    <PackRootReadme>false</PackRootReadme>
    <Description>Compatibility metapackage: depends on FeatherQR.SkiaSharp (QR Code, Micro QR and rMQR with SkiaSharp rendering). Reference FeatherQR.SkiaSharp directly in new projects.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- NU5128: a package with dependency groups but no lib/ folder is exactly what this is. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Nothing to compare: there is no assembly. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeatherQR.SkiaSharp\FeatherQR.SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
