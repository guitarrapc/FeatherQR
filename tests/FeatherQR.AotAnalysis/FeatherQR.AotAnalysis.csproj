<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT compatibility gate. Publishing this project runs the full ILC trim/AOT analysis
       over the entire library (TrimmerRootAssembly roots every member, not just the ones Program.cs
       happens to call) and fails on any IL#### warning. CI publishes it on every PR. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Report every warning site individually instead of one collapsed warning per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The gate: any trim/AOT analysis warning fails the publish. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyze the whole library surface, including code the entry point does not reach. -->
    <TrimmerRootAssembly Include="FeatherQR" />
    <TrimmerRootAssembly Include="FeatherQR.SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="$(RuntimeIdentifier.StartsWith('win'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FeatherQR.SkiaSharp\FeatherQR.SkiaSharp.csproj" />
  </ItemGroup>

  <!-- The timing mode's images come from the test suite's renderers (no SkiaSharp, so the WebAssembly report draws the same pixels). -->
  <ItemGroup>
    <Compile Include="..\FeatherQR.Tests\Shared\NearestNeighbourRenderer.cs" Link="Renderers\NearestNeighbourRenderer.cs" />
    <Compile Include="..\FeatherQR.Tests\Shared\SupersampledRenderer.cs" Link="Renderers\SupersampledRenderer.cs" />
  </ItemGroup>

</Project>
