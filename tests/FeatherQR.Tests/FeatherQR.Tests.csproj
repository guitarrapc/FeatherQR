<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- An unawaited async assertion helper cannot fail its test: its exception stays inside the dropped Task. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS4014</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp.V2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FeatherQR\FeatherQR.csproj" />
    <ProjectReference Include="..\..\src\FeatherQR.SkiaSharp\FeatherQR.SkiaSharp.csproj" />
    <ProjectReference Include="..\..\src\FeatherQR.Gs1\FeatherQR.Gs1.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GS1 table generator (Gs1AiTableGeneratorTest) reads the pinned Syntax Dictionary with the same parser
         the fixture tool uses, so the two cannot drift apart. -->
    <Compile Include="..\..\tools\QRInteropFixtures\Gs1SyntaxDictionary.cs" Link="Gs1\Gs1SyntaxDictionary.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="testdata\**\*.pixels">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
