<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--Roslyn's MSBuildWorkspace could not then match those project references to their metadata references. (default true for 5.0+, force true for netstandard) -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- Deterministic build -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)opensource.snk</AssemblyOriginatorKeyFile>

    <!-- NuGet -->
    <IsPackable>false</IsPackable>
    <Version>2.0.0-preview.3</Version>
    <Authors>guitarrapc</Authors>
    <Copyright>© guitarrapc</Copyright>
    <PackageTags>skia, skiasharp, qrcode, microqr, rmqr</PackageTags>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageProjectUrl>https://github.com/guitarrapc/FeatherQR</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>$(PackageProjectUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="'$(PackRootReadme)' != 'false'" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)LICENSE" />
  </ItemGroup>
</Project>
