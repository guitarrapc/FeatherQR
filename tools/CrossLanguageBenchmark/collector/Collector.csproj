<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-language benchmark's collector: corpus, launching, verification and every statistic. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>collector</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FeatherQR\FeatherQR.csproj" />
  </ItemGroup>

  <!-- The corpus is checked through the CLI's own calls, and drawn by the test suite's renderer. -->
  <ItemGroup>
    <Compile Include="..\dotnet\cli\Operations.cs" Link="Shared\Operations.cs" />
    <Compile Include="..\dotnet\cli\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\dotnet\cli\Pgm.cs" Link="Shared\Pgm.cs" />
    <Compile Include="..\..\..\tests\FeatherQR.Tests\Shared\NearestNeighbourRenderer.cs" Link="Shared\NearestNeighbourRenderer.cs" />
  </ItemGroup>

</Project>
