<Project Sdk="Microsoft.NET.Sdk">

  <!-- FeatherQR's CLI for the cross-language benchmark, on the core package only.
       Kept free of reflection-based APIs, since the NativeAOT phase publishes this same project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>featherqr-cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Switched on here rather than by -p:PublishAot, which would reach the library's netstandard2.0 build as a global property. -->
    <PublishAot Condition="'$(XlangNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FeatherQR\FeatherQR.csproj" />
  </ItemGroup>

  <!-- A NativeAOT publish stamps its instruction-set target, which the protocol's build member reports beside "nativeaot". -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <AssemblyMetadata Include="IlcInstructionSet" Value="$([MSBuild]::ValueOrDefault('$(IlcInstructionSet)', 'default'))" />
  </ItemGroup>

</Project>
