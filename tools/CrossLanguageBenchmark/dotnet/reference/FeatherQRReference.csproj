<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet over the CLIs' own calls and the same corpus: the measurement the CLI's loop is held against,
       and zxing-cpp's .NET package for the wrapper's cost. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ZXingCpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FeatherQR\FeatherQR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\cli\Operations.cs" Link="Shared\Operations.cs" />
    <Compile Include="..\cli\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\cli\Pgm.cs" Link="Shared\Pgm.cs" />
    <Compile Include="..\zxingcpp\ZXingCppOperations.cs" Link="Shared\ZXingCppOperations.cs" />
    <Compile Include="..\..\collector\Manifest.cs" Link="Shared\Manifest.cs" />
  </ItemGroup>

</Project>
