<Project Sdk="Microsoft.NET.Sdk">

  <!-- zxing-cpp's .NET package as a CLI of the cross-language benchmark, against the native zxing-cpp CLI built from the commit the
       package ships, to measure what the wrapper adds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>zxingcpp-net-cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZXingCpp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\cli\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\cli\Pgm.cs" Link="Shared\Pgm.cs" />
  </ItemGroup>

</Project>
