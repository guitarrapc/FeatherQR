<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned clones of external oracles (get-gs1-syntax-engine.ps1) live under external/; their sources are data, not part of this tool. -->
    <Compile Remove="external/**" />
    <None Remove="external/**" />
    <EmbeddedResource Remove="external/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="ZXingCpp" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
    <PackageReference Include="CodeGlyphX" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FeatherQR.SkiaSharp\FeatherQR.SkiaSharp.csproj" />
    <ProjectReference Include="..\..\src\FeatherQR.Gs1\FeatherQR.Gs1.csproj" />
  </ItemGroup>

</Project>
